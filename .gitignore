# 永远不要忽略Asset meta文件
!Assets/**/*.meta

# 构建缓存
[Aa]ssets/AssetStoreTools*
[Aa]ssets/StreamingAssets/*.dll
[Aa]ssets/StreamingAssets/*.pdb

# Visual Studio缓存目录
.vs/

# Gradle缓存目录 (Android构建)
.gradle/

