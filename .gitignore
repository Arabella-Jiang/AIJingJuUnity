*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D生成的文件错误
*.stackdump

# Unity编辑器崩溃报告
sysinfo.txt

# Builds构建输出
*.apk
*.unitypackage
*.aab

# Crashlytics生成的文件
crashlytics-build.properties

# Packed Addressables资源
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# 临时自动保存文件
[Aa]ssets/Scenes/*.tmp

# Fmod缓存
fmod_editor.log

